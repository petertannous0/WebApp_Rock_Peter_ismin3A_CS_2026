datasource db {
  provider = "sqlite"
}

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

enum Role {
  ADMIN
  ENSEIGNANT
  ELEVE
}

/// A login. Business data lives in Teacher / Student, linked to at most one User:
/// a person can exist before the admin creates their account.
model User {
  id           Int     @id @default(autoincrement())
  email        String  @unique
  passwordHash String
  role         Role

  teacher Teacher?
  student Student?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Teacher {
  id        Int    @id @default(autoincrement())
  firstName String
  lastName  String
  email     String @unique

  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId Int?  @unique

  /// Set when the teacher saves their unavailability, even an empty list:
  /// null means "has not answered yet" in the admin overview.
  availabilitySubmittedAt DateTime?

  unavailabilities      TeacherUnavailability[]
  tutoredStudents       Student[]               @relation("AcademicTutor")
  secondTeacherDefenses Defense[]               @relation("SecondTeacher")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Company {
  id   Int    @id @default(autoincrement())
  name String @unique

  tutors   CompanyTutor[]
  students Student[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanyTutor {
  id        Int    @id @default(autoincrement())
  firstName String
  lastName  String
  email     String @unique

  company   Company @relation(fields: [companyId], references: [id])
  companyId Int

  students Student[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model Student {
  id        Int    @id @default(autoincrement())
  firstName String
  lastName  String
  email     String @unique

  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId Int?  @unique

  company   Company @relation(fields: [companyId], references: [id])
  companyId Int

  companyTutor   CompanyTutor @relation(fields: [companyTutorId], references: [id])
  companyTutorId Int

  academicTutor   Teacher @relation("AcademicTutor", fields: [academicTutorId], references: [id])
  academicTutorId Int

  defense Defense?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyTutorId])
  @@index([academicTutorId])
}

enum HalfDay {
  MORNING
  AFTERNOON
}

/// One week, Monday to Friday. The app manages one session at a time.
model Session {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  /// The Monday, at midnight UTC.
  startDate DateTime

  rooms Room[]
  slots Slot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Room {
  id        Int    @id @default(autoincrement())
  name      String
  videoLink String
  closedThursdayAfternoon Boolean @default(false)

  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId Int

  defenses Defense[]

  @@unique([sessionId, name])
}

model Slot {
  id           Int      @id @default(autoincrement())
  date         DateTime
  /// 0 = Monday … 4 = Friday.
  dayIndex     Int
  /// 0 … 11 in the day: 0–5 morning, 6–11 afternoon.
  indexInDay   Int
  /// Minutes since midnight: 510 = 8:30.
  startMinutes Int
  halfDay      HalfDay

  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId Int

  defenses Defense[]

  @@unique([sessionId, dayIndex, indexInDay])
}

model TeacherUnavailability {
  id      Int      @id @default(autoincrement())
  date    DateTime
  halfDay HalfDay

  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId Int

  @@unique([teacherId, date, halfDay])
}

/// A placed defense. The jury is the student's academic tutor + `secondTeacher`
/// + the student's company tutor: the first and last are read from the student,
/// never copied here.
model Defense {
  id Int @id @default(autoincrement())

  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId Int     @unique

  slot   Slot @relation(fields: [slotId], references: [id])
  slotId Int

  room   Room @relation(fields: [roomId], references: [id])
  roomId Int

  secondTeacher   Teacher @relation("SecondTeacher", fields: [secondTeacherId], references: [id])
  secondTeacherId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([slotId, roomId])
  @@index([secondTeacherId])
}
